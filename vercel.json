{
  "buildCommand": "npm run build",
  "redirects": [
    { "source": "/automation-n8n", "destination": "/automatizacion-restaurantes-n8n", "permanent": true },
    { "source": "/whatsapp-automation", "destination": "/automatizacion-whatsapp-restaurante", "permanent": true },
    { "source": "/software-canarias", "destination": "/software-restaurantes-canarias", "permanent": true },
    { "source": "/digitalization-tenerife", "destination": "/digitalizacion-hosteleria-tenerife", "permanent": true },
    { "source": "/contacto", "destination": "/#contacto", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://*.supabase.co https://generativelanguage.googleapis.com https://*.vercel.app https://*.up.railway.app; frame-src 'none';"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Robots-Tag", "value": "index, follow" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        {
          "key": "Link",
          "value": "</.well-known/api-catalog>; rel=\"api-catalog\", </llms.txt>; rel=\"ai-readable\", </.well-known/mcp/server-card.json>; rel=\"api-catalog\", </.well-known/openid-configuration>; rel=\"oauth2-authorization-server\", </.well-known/oauth-protected-resource>; rel=\"protected-resource\""
        },
        { "key": "Content-Signal", "value": "ai-train=no, search=yes, ai-input=no" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(|about|servicios|carta-digital|tap-review|automatizacion-restaurantes-n8n|automatizacion-whatsapp-restaurante|software-restaurantes-canarias|digitalizacion-hosteleria-tenerife)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/servicios", "destination": "/servicios/index.html" },
    { "source": "/carta-digital", "destination": "/carta-digital/index.html" },
    { "source": "/tap-review", "destination": "/tap-review/index.html" },
    { "source": "/automatizacion-restaurantes-n8n", "destination": "/automatizacion-restaurantes-n8n/index.html" },
    { "source": "/automatizacion-whatsapp-restaurante", "destination": "/automatizacion-whatsapp-restaurante/index.html" },
    { "source": "/software-restaurantes-canarias", "destination": "/software-restaurantes-canarias/index.html" },
    { "source": "/digitalizacion-hosteleria-tenerife", "destination": "/digitalizacion-hosteleria-tenerife/index.html" },
    { "source": "/legal/aviso", "destination": "/legal/aviso/index.html" },
    { "source": "/legal/privacidad", "destination": "/legal/privacidad/index.html" },
    { "source": "/legal/cookies", "destination": "/legal/cookies/index.html" },
    { "source": "/admin/:path*", "destination": "/_spa.html" },
    { "source": "/panel/:path*", "destination": "/_spa.html" },
    { "source": "/login/:path*", "destination": "/_spa.html" },
    { "source": "/:path*", "destination": "/_spa.html" }
  ]
}
